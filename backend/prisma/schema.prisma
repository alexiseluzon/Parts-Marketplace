generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Mirrors auth.users (managed by Supabase Auth). One row per user,
// created via a DB trigger on auth.users insert (see migration.sql).
model Profile {
  id    String @id @db.Uuid
  email String @unique
  role  String @default("user") // "user" | "admin"
  parts Part[]

  @@map("profiles")
}

model Part {
  id       String  @id @default(cuid())
  name     String
  sku      String  @unique
  price    Float
  quantity Int
  ownerId  String  @db.Uuid
  owner    Profile @relation(fields: [ownerId], references: [id])

  @@map("parts")
}
