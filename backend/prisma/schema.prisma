generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  parts        Part[]
}

model Part {
  id       String @id @default(cuid())
  name     String
  sku      String @unique
  price    Float
  quantity Int
  ownerId  String
  owner    User   @relation(fields: [ownerId], references: [id])
}
